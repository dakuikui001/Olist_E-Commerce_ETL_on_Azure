		level Minute
			lineageTag: cb667279-ce68-4be9-a033-41037bc48291
			column: Minute

	partition Time_Table = calculated
		mode: import
		source = ```
				
				VAR SecondsInDay = GENERATESERIES ( 0, 86399 ) 
				RETURN
				SELECTCOLUMNS (
				    SecondsInDay,
				    "Time", 
				        VAR TotalSeconds = [Value]
				        VAR Hrs = QUOTIENT(TotalSeconds, 3600)
				        VAR Mins = QUOTIENT(MOD(TotalSeconds, 3600), 60)
				        VAR Secs = MOD(TotalSeconds, 60)
				        RETURN TIME(Hrs, Mins, Secs),
				    "Hour", QUOTIENT([Value], 3600),
				    "Minute", QUOTIENT(MOD([Value], 3600), 60),
				    "Second", MOD([Value], 60), -- 直接取余数即为秒 (0-59)
				    "TimeKey", 
				        VAR TotalSeconds = [Value]
				        VAR Hrs = FORMAT(QUOTIENT(TotalSeconds, 3600), "00")
				        VAR Mins = FORMAT(QUOTIENT(MOD(TotalSeconds, 3600), 60), "00")
				        VAR Secs = FORMAT(MOD(TotalSeconds, 60), "00")
				        RETURN Hrs & ":" & Mins & ":" & Secs,
				    "TimeRange", 
				        VAR H = QUOTIENT([Value], 3600)
				        RETURN
				        SWITCH ( TRUE(),
				            H < 6, "Night",
				            H < 12, "Morning",
				            H < 18, "Afternoon",
				            "Evening"
				        ))
				```

	annotation PBI_Id = f4bb555273d84db5ab570f0079d6edeb

